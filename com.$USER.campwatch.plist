<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.$USER.campwatch</string>

    <key>ProgramArguments</key>
    <array>
      <string>/Users/$USER/campwatch/run_campwatch.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Every 10 minutes -->
    <key>StartInterval</key>
    <integer>600</integer>

    <!-- Only run when network is up -->
    <key>KeepAlive</key>
    <dict>
      <key>NetworkState</key>
      <true/>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/campwatch.out.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/campwatch.err.log</string>
  </dict>
</plist>
